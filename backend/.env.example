PROJECT_NAME="COPO Vision API"
API_V1_STR="/api/v1"

# Required: Strong, non-default secret key (min 16 chars, 32+ recommended)
# e.g., generate with: openssl rand -hex 32
SECRET_KEY="replace-this-with-a-secure-random-secret-key-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="copovision"
POSTGRES_PORT="5432"
